# Supabase project URL — Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key — safe for client-side use, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses RLS, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app — used for auth redirects and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
